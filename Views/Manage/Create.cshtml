@model CampusPulse.Models.CampusEvent
@{ ViewData["Title"] = "Іс-шара қосу"; }
<section class="form-page"><a class="back-link" asp-action="Index">← Басқару панеліне қайту</a><div class="form-heading"><div class="eyebrow muted">ЖАҢА ОҚИҒА</div><h1>Кампусты жандандырайық.</h1><p>Іс-шараң жайлы негізгі мәліметтерді толтыр.</p></div><form asp-action="Create" method="post" class="event-form"><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-two"><label asp-for="Title">Іс-шара атауы<input asp-for="Title" placeholder="Мысалы, Ашық микрофон кеші"/><span asp-validation-for="Title"></span></label><label asp-for="Club">Клуб атауы<input asp-for="Club" placeholder="Мысалы, Stage Lab"/><span asp-validation-for="Club"></span></label></div><div class="form-two"><label asp-for="Category">Санат<input asp-for="Category" placeholder="Музыка, Спорт, Кино…"/><span asp-validation-for="Category"></span></label><label asp-for="Organizer">Ұйымдастырушы<input asp-for="Organizer" placeholder="Аты-жөні"/><span asp-validation-for="Organizer"></span></label></div><label asp-for="Summary">Қысқаша сипаттама<textarea asp-for="Summary" rows="4" placeholder="Қатысушыларды не күтіп тұр?"></textarea><span asp-validation-for="Summary"></span></label><div class="form-two"><label asp-for="Venue">Өтетін орны<input asp-for="Venue" placeholder="Корпус, аудитория немесе мекенжай"/><span asp-validation-for="Venue"></span></label><label asp-for="StartsAt">Күні мен уақыты<input asp-for="StartsAt" type="datetime-local"/><span asp-validation-for="StartsAt"></span></label></div><div class="form-two"><label asp-for="Capacity">Қатысушы саны<input asp-for="Capacity" type="number" min="1" max="500"/><span asp-validation-for="Capacity"></span></label><label class="check-label" asp-for="IsFeatured"><input asp-for="IsFeatured"/> Басты бетте ерекшелеу</label></div><button class="primary-button" type="submit">Жариялау <span>→</span></button></form></section>
