@model IReadOnlyList<CampusPulse.Models.CampusEvent>
@{ ViewData["Title"] = "Іс-шараларды басқару"; }
<section class="manage-page"><div class="section-heading"><div><div class="eyebrow muted">ҰЙЫМДАСТЫРУШЫ ПАНЕЛІ</div><h1>Іс-шараларың</h1></div><a class="primary-button button-inline" asp-action="Create">+ Жаңа іс-шара</a></div>@if (TempData["Notice"] is string note) { <div class="notice">@note</div> }<div class="manage-table"><div class="table-head"><span>ІС-ШАРА</span><span>КҮНІ</span><span>ТІРКЕЛГЕН</span><span>ӘРЕКЕТ</span></div>@foreach (var item in Model) { <div class="table-row"><div><span class="table-category">@item.Category</span><strong>@item.Title</strong><small>@item.Club</small></div><span>@item.StartsAt.ToString("dd.MM.yyyy HH:mm")</span><span>@item.Registrations.Count(r => !r.IsWaitlisted) / @item.Capacity</span><div class="row-actions"><a asp-controller="Events" asp-action="Details" asp-route-id="@item.Id">Ашу ↗</a><form asp-action="Delete" method="post" onsubmit="return confirm('Іс-шараны өшіру керек пе?')"><input type="hidden" name="id" value="@item.Id"/><button class="delete-link" type="submit">Өшіру</button></form></div></div> }</div></section>
