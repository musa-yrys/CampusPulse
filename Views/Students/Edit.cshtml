@model Student
@{ ViewData["Title"] = "Студентті өңдеу"; }
<section class="page-shell form-page">
    <a class="back-link" asp-action="Index">← Тізімге оралу</a>
    <div class="form-heading"><span class="eyebrow">ДЕРЕКТЕРДІ ЖАҢАРТУ</span><h1>Студентті өңдеу</h1><p>@Model.LastName @Model.FirstName деректерін өзгертіңіз.</p></div>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="student-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <partial name="_StudentFields" model="Model" />
        <div class="form-actions"><button class="primary-button" type="submit">Өзгерістерді сақтау</button><a class="secondary-button" asp-action="Index">Болдырмау</a></div>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
