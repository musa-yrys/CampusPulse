@model Student
@{ ViewData["Title"] = "Студент қосу"; }
<section class="page-shell form-page">
    <a class="back-link" asp-action="Index">← Тізімге оралу</a>
    <div class="form-heading"><span class="eyebrow">ЖАҢА ЖАЗБА</span><h1>Студентті тіркеу</h1><p>Студенттің деректерін толтырыңыз.</p></div>
    <form asp-action="Create" method="post" class="student-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <partial name="_StudentFields" model="Model" />
        <div class="form-actions"><button class="primary-button" type="submit">Студентті сақтау</button><a class="secondary-button" asp-action="Index">Болдырмау</a></div>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
