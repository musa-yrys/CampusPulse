@model CampusPulse.ViewModels.EventDetailsViewModel
@{ ViewData["Title"] = Model.Event.Title; }
<section class="detail-wrap"><a class="back-link" asp-action="Index">← Барлық іс-шараға қайту</a><div class="detail-grid"><article class="detail-main"><div class="detail-cover cover-@((Model.Event.Id % 4) + 1)"><span class="category-tag">@Model.Event.Category</span><span class="detail-glyph">✳</span><span class="club-pill">@Model.Event.Club</span></div><div class="detail-content"><div class="eyebrow muted">@Model.Event.Club · ҰЙЫМДАСТЫРУШЫ @Model.Event.Organizer</div><h1>@Model.Event.Title</h1><p>@Model.Event.Summary</p><div class="detail-facts"><div><small>КҮНІ МЕН УАҚЫТЫ</small><strong>@Model.Event.StartsAt.ToString("dd.MM.yyyy · HH:mm")</strong></div><div><small>ӨТЕТІН ЖЕРІ</small><strong>@Model.Event.Venue</strong></div></div></div></article><aside class="signup-card"><div class="eyebrow muted">ҚАТЫСУ</div><div class="seats"><strong>@Model.PlacesLeft</strong><span> бос орын<br />қалды</span></div><div class="meter"><i style="width:@(Model.Event.Capacity == 0 ? 0 : Math.Min(100, Model.RegisteredCount * 100 / Model.Event.Capacity))%"></i></div><p>Барлығы @Model.Event.Capacity орынның @Model.RegisteredCount-ы алынды.</p>@if (TempData["Notice"] is string note) { <div class="notice">@note</div> }<form asp-action="Register" method="post"><input type="hidden" name="eventId" value="@Model.Event.Id"/><label>Аты-жөніңіз<input name="studentName" required maxlength="60" placeholder="Мысалы, Айдана Әли"/></label><label>Email<input name="email" type="email" required maxlength="120" placeholder="you@university.kz"/></label><button class="primary-button" type="submit">Қатысуға тіркелу <span>→</span></button><small class="form-note">Орын қалмаса, күту тізіміне қосыласыз.</small></form></aside></div></section>
