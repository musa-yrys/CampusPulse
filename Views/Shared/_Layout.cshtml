<!DOCTYPE html>
<html lang="kk">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] · CampusPulse</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
  <header class="topbar"><a class="brand" asp-controller="Events" asp-action="Index"><span class="brand-mark">cp</span><span>campus<span class="brand-light">pulse</span></span></a>
    <nav><a asp-controller="Events" asp-action="Index">Іс-шаралар</a><a asp-controller="Manage" asp-action="Index">Ұйымдастырушыға</a></nav>
    <a class="top-cta" asp-controller="Manage" asp-action="Create">+ Іс-шара қосу</a>
  </header>
  <main>@RenderBody()</main>
  <footer><span>campus<span class="brand-light">pulse</span></span><span>Кампус өмірі осы жерден басталады.</span><span>© 2026</span></footer>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
