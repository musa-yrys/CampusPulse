<!DOCTYPE html>
<html lang="kk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Student Registration System</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-controller="Students" asp-action="Index"><span class="brand-mark">SR</span><span>Student<span class="brand-light">Registry</span></span></a>
        <nav><a asp-controller="Students" asp-action="Index">Студенттер</a><a href="#about">Жүйе туралы</a></nav>
        <a class="top-cta" asp-controller="Students" asp-action="Create">+ Студент қосу</a>
    </header>
    <main>@RenderBody()</main>
    <footer id="about"><span>Student Registration System</span><span>Студенттерді тіркеу және басқару жүйесі</span><span>© 2026</span></footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
